   "pecas": [
    {
     "termo": "1 para 4",
     "significado": "A cada 1 de um, vão 4 do outro. Chama-se razão."
    }
   ],
   "passos": [
    {
     "titulo": "As fórmulas desta questão",
     "texto": "Estas são as fórmulas que a questão usa. Já estão prontas: é só usar.",
     "visual": {
      "tipo": "formulas",
      "itens": [
       {
        "figura": "porcentagem",
        "nome": "Razão",
        "formula": "água = concentrado × quantos de água por copo"
