{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(curl * | sh)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npx prisma db push*)",
      "Bash(psql*)"
    ],
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  }
}
