generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique
  email         String?
  password      String
  role          String    @default("user")
  themeColor    String    @default("clareza")
  streakDays    Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress          UserProgress[]
  reviews           ReviewSchedule[]
  trainingSessions  TrainingSession[]
  essays            Essay[]
  essayParts        EssayPartPractice[]
  flashcardDecks    FlashcardDeck[]
  flashcardProgress FlashcardProgress[]
  customExams       CustomExam[]
  studyProgress     StudyProgress[]
  calculoProgresso  CalculoProgresso[]

  @@index([username])
}

model Question {
  id                 String   @id @default(cuid())
  enunciado          String
  alternativaA       String
  alternativaB       String
  alternativaC       String
  alternativaD       String
  alternativaE       String
  respostaCorreta    String
  materia            String
  subtema            String
  tema               String? // taxonomia enxuta por materia (lib/tema-taxonomy.ts); subtema preservado como estava
  dificuldade        String
  nivel              String? // FACIL, MEDIO, MODELO_ENEM, VESTIBULAR
  explicacao         String?
  origem             String?
  dependeImagem      Boolean  @default(false)
  geradaPorIA        Boolean  @default(false)
  numeroQuestao      Int?
  anoProva           Int?
  diaProva           Int?
  pdfFileUrl         String?
  paginaPdf          Int?
  imagemUrl          String?
  imagemUrlExpandida String?
  ancoraId           String? // questão do ENEM que esta prepara (degrau gerado por IA, lib/treino-degraus.ts)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  progress            UserProgress[]
  reviews             ReviewSchedule[]
  sessions            TrainingSessionQuestion[]
  customExamQuestions CustomExamQuestion[]
  explicacaoPronta    ExplicacaoPronta?

  @@index([materia])
  @@index([dificuldade])
  @@index([nivel])
  @@index([materia, nivel])
  @@index([materia, dificuldade])
  @@index([anoProva, diaProva, numeroQuestao])
  @@index([ancoraId])
}

model TrainingSession {
  id          String   @id @default(cuid())
  userId      String
  currentIdx  Int      @default(0)
  correct     Int      @default(0)
  wrong       Int      @default(0)
  finished    Boolean  @default(false)
  mode        String   @default("normal")
  timeLeft    Int      @default(0)
  timeElapsed Int      @default(0)
  timerHours  Float    @default(0)
  useTimer    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions TrainingSessionQuestion[]

  @@index([userId, finished])
  @@index([userId, mode, finished])
}

model TrainingSessionQuestion {
  id           String  @id @default(cuid())
  sessionId    String
  questionId   String
  ordem        Int
  answered     Boolean @default(false)
  respostaDada String?

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId, ordem])
}

model UserProgress {
  id                  String   @id @default(cuid())
  userId              String
  questionId          String
  acertou             Boolean
  respostaDada        String
  tentativas          Int      @default(1)
  explicacaoEstudante String?
  dominada            Boolean  @default(false)
  acertosConsecutivos Int      @default(0)
  dataResposta        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
  @@index([userId, acertou])
  @@index([userId, dataResposta])
}

model StudyProgress {
  id          String    @id @default(cuid())
  userId      String
  weekNumber  Int // 1-4, corresponde a studyCycle[weekNumber-1] em lib/schedule-data.ts
  dayIndex    Int // 0-6, posição do dia DENTRO do plano da semana — não é o dia da semana civil
  status      String    @default("nao_iniciado") // nao_iniciado | em_andamento | concluido | pulado
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, dayIndex])
  @@index([userId, status])
}

model ReviewSchedule {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  proximaRevisao DateTime
  intervaloAtual Int      @default(1)
  completada     Boolean  @default(false)
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, proximaRevisao])
  @@index([userId, completada])
}

model EssayTheme {
  id               String   @id @default(cuid())
  tema             String   @unique
  anoEnem          Int?
  textoMotivador   String?  @db.Text
  areaConhecimento String?
  createdAt        DateTime @default(now())

  essays Essay[]
}

model EssayPartPractice {
  id        String   @id @default(cuid())
  userId    String
  partType  String // introducao, desenvolvimento1, desenvolvimento2, conclusao
  tema      String
  textoBase String   @db.Text // the partial essay text provided
  resposta  String   @db.Text // user's written part
  feedback  String?  @db.Text // AI feedback
  nota      Int? // 0-10 score
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, partType])
}

model Essay {
  id        String   @id @default(cuid())
  userId    String
  themeId   String
  texto     String   @db.Text
  status    String   @default("pendente") // pendente, avaliando, avaliada
  notaC1    Int?
  notaC2    Int?
  notaC3    Int?
  notaC4    Int?
  notaC5    Int?
  notaTotal Int?
  avaliacao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme EssayTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model EssayPartTemplate {
  id             String   @id @default(cuid())
  partType       String // introducao, desenvolvimento1, desenvolvimento2, conclusao
  tema           String
  textoMotivador String   @db.Text // motivational texts (multiple paragraphs)
  textoBase      String   @db.Text // the partial essay (with the missing part marked)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([partType, isActive])
}

model FlashcardDeck {
  id        String   @id @default(cuid())
  userId    String? // null = default/system deck available to all
  nome      String
  materia   String
  subtema   String?
  descricao String?
  cor       String?
  isDefault Boolean  @default(false)
  capituloLido Int   @default(0) // deck de livro: até que capítulo já foi lido
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Flashcard[]

  @@index([userId])
  @@index([materia])
  @@index([isDefault])
}

model Flashcard {
  id        String   @id @default(cuid())
  deckId    String
  frente    String   @db.Text // question/term
  verso     String   @db.Text // answer/definition
  dica      String?  @db.Text
  ordem     Int      @default(0)
  capitulo  Int? // deck de livro: tranca até ler este capítulo (spoiler)
  createdAt DateTime @default(now())

  deck     FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress FlashcardProgress[]

  @@index([deckId])
}

model FlashcardProgress {
  id             String   @id @default(cuid())
  userId         String
  cardId         String
  acertou        Boolean
  precisaRevisar Boolean  @default(false) // marked for review when wrong
  dataResposta   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, cardId])
  @@index([userId, precisaRevisar])
}

model CustomExam {
  id            String    @id @default(cuid())
  userId        String
  nome          String
  nivel         String // facil, medio, vestibular
  materias      String[] // array of subjects
  totalQuestoes Int
  status        String    @default("pendente") // pendente, em_andamento, finalizada
  currentIdx    Int       @default(0)
  acertos       Int       @default(0)
  erros         Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions CustomExamQuestion[]

  @@index([userId])
  @@index([userId, status])
}

model CustomExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  questionId   String
  ordem        Int
  answered     Boolean  @default(false)
  respostaDada String?
  acertou      Boolean?

  exam     CustomExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId, ordem])
}

// Trilha de Cálculo (data/calculo/trilha.ts). Uma linha por degrau tocado.
model CalculoProgresso {
  id             String    @id @default(cuid())
  userId         String
  licaoId        String // id do degrau na trilha (p1, c4...)
  status         String    @default("em_andamento") // em_andamento | concluida
  acertos        Int       @default(0)
  tentativas     Int       @default(0)
  revisoes       Int       @default(0) // revisões seguidas acertadas (define o próximo intervalo)
  proximaRevisao DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, licaoId])
  @@index([userId, proximaRevisao])
}

// Lições da trilha geradas por IA, salvas na primeira vez (as escritas à mão
// ficam em data/calculo/licoes e não passam por aqui).
model CalculoLicaoGerada {
  licaoId   String   @id
  conteudo  Json
  modelo    String?
  createdAt DateTime @default(now())
}

// Explicação da questão gerada antes, guardada e revisada (Pablo, 22/10/2026:
// "já deixa várias prontas e você revisa"). Feita sem a alternativa marcada:
// o "onde você desviou" é pedido à parte quando o aluno erra. `versao` sobe
// quando o formato muda (lib/tutor/pronta.ts); versão velha é ignorada.
model ExplicacaoPronta {
  id         String   @id @default(cuid())
  questionId String   @unique
  versao     Int
  conteudo   Json
  revisada   Boolean  @default(false)
  problemas  String?  // o que a revisão automática achou; vazio = passou
  modelo     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@index([versao, revisada])
}
